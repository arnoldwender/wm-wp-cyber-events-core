#: blocks/agenda-matrix/block.json
msgctxt "block title"
msgid "Cyber Events Konferenz-Agenda"
msgstr "Cyber Events — Program konferencie"

#: blocks/agenda-matrix/block.json
msgctxt "block description"
msgid ""
"Interaktiver Multi-Track Konferenzplan mit Zeitstrahl, Referenten-Details, "
"Raumfiltern und iCal (.ics) Download."
msgstr ""
"Interaktívny viacokruhový plán konferencie s časovou osou, podrobnosťami "
"rečníkov, filtrami sál a stiahnutím súboru iCal (.ics)."

#: blocks/calendar-views/block.json
msgctxt "block title"
msgid "Cyber Events Multi-View Pro (Kalender, Agenda & Tracks)"
msgstr "Cyber Events Multi-View Pro (kalendár, program a okruhy)"

#: blocks/calendar-views/block.json
msgctxt "block description"
msgid ""
"Erweiterte Kalender- & Agenda-Suite mit 7 interaktiven Frontend-Ansichten: "
"Monatskalender, Wochenplan, Tagesagenda, Listenansicht, Fotokarten, "
"Raumkarte und Summit Multi-Track Matrix."
msgstr ""
"Rozšírený balík kalendára a programu so 7 interaktívnymi zobrazeniami: "
"mesačný kalendár, týždenný rozvrh, denný program, zobrazenie zoznamu, "
"fotografické karty, mapa sál a viacokruhová matica summitu."

