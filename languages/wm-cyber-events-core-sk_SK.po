msgctxt "block keyword"
msgid "event"
msgstr "podujatie"

#: blocks/calendar-views/block.json
msgctxt "block keyword"
msgid "calendar"
msgstr "kalendár"

#: blocks/calendar-views/block.json
msgctxt "block keyword"
msgid "agenda"
msgstr "program"

#: blocks/calendar-views/block.json
