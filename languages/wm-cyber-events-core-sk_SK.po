msgid "timetable"
msgstr "harmonogram"

#: blocks/calendar-views/block.json
msgctxt "block keyword"
msgid "matrix"
msgstr "matica"

#: blocks/calendar-widget/block.json
msgctxt "block title"
msgid "Cyber Events Kalender & .ics Widget"
msgstr "Cyber Events — Widget kalendára a .ics"

#: blocks/calendar-widget/block.json
msgctxt "block description"
msgid ""
"Kalender-Widget mit .ics-Download und Links zu Google Kalender, Outlook Web "
"und Microsoft 365."
msgstr ""
"Kalendárový widget so stiahnutím súboru .ics a odkazmi do Kalendára Google, "
"Outlook Web a Microsoft 365."

#: blocks/event-hero/block.json
msgctxt "block title"
msgid "Cyber Event Hero & Countdown Banner"
msgstr "Cyber Event — Úvodný baner a odpočítavanie"

#: blocks/event-hero/block.json
msgctxt "block description"
msgid ""
"Veranstaltungs-Kopfbereich mit Countdown, Eckdaten, Status und Anmelde-"
"Buttons."
msgstr ""
"Úvodná sekcia podujatia s odpočítavaním, kľúčovými údajmi, stavom a "
"registračnými tlačidlami."

#: blocks/events-grid/block.json
msgctxt "block title"
msgid "Cyber Events Übersicht & Archiv Grid"
msgstr "Cyber Events — Mriežka prehľadu a archívu"

#: blocks/events-grid/block.json
msgctxt "block description"
msgid ""
"Dynamische Kartenübersicht aller anstehenden Konferenzen, Symposien und "
"Workshops mit Suchleiste und Status-Filtern."
msgstr ""
"Dynamický kartový prehľad nadchádzajúcich konferencií, sympózií a workshopov "
"s vyhľadávacím panelom a filtrami stavu."

#: blocks/registration-form/block.json
msgctxt "block title"
msgid "Cyber Events Registrierungsformular"
msgstr "Cyber Events — Registračný formulár"

#: blocks/registration-form/block.json
msgctxt "block description"
msgid ""
"Anmeldeformular mit Double Opt-in über Brevo, optionalem Profilbild und "
"Einwilligung zu Fotoaufnahmen."
msgstr ""
"Registračný formulár s dvojitým potvrdením cez Brevo, voliteľnou profilovou "
"fotografiou a súhlasom s fotografovaním."

#: blocks/seat-map/block.json
msgctxt "block title"
msgid "Cyber Events Sitzplan"
msgstr "Cyber Events — Plán miest"

#: blocks/seat-map/block.json
msgctxt "block description"
msgid ""
"Belegung aller Sessions einer Veranstaltung als SVG, laufend aktualisiert "
"über Server-Sent Events."
msgstr ""
"Obsadenosť všetkých sekcií podujatia ako grafika SVG, priebežne "
"aktualizovaná pomocou Server-Sent Events."

#: blocks/security-trust-badge/block.json
msgctxt "block title"
msgid "Cyber Events Security & Trust Badges"
msgstr "Cyber Events — Odznaky bezpečnosti a dôvery"

#: blocks/security-trust-badge/block.json
msgctxt "block description"
msgid ""
"Übersicht der Datenschutz- und Sicherheitsfunktionen des Plugins: Double Opt-"
"in, Löschfristen, Audit-Log, Rechnungs-XML."
msgstr ""
"Prehľad funkcií ochrany osobných údajov a zabezpečenia pluginu: Double Opt-"
"in, lehoty uchovávania, auditný protokol, fakturačné XML."

#: blocks/session-selector/block.json
msgctxt "block title"
msgid "Cyber Events Session- & Workshop-Selektor"
msgstr "Cyber Events — Výber sekcií a workshopov"

#: blocks/session-selector/block.json
msgctxt "block description"
msgid ""
"Session-Auswahl für bestätigte Anmeldungen: Plätze werden beim Speichern "
"vergeben, solange die Session nicht ausgebucht ist."
msgstr ""
"Výber sekcií pre potvrdené registrácie: miesta sa prideľujú pri uložení, kým "
"nie je kapacita vyčerpaná."

#: blocks/speaker-grid/block.json
msgctxt "block title"
msgid "Cyber Events Referenten & Speaker Grid"
msgstr "Cyber Events — Mriežka rečníkov a expertov"

#: blocks/speaker-grid/block.json
msgctxt "block description"
msgid ""
"Automatisch generierte Übersicht aller Keynote-Speaker, Referenten, "
"Raumverteilung und Bio-Details."
msgstr ""
"Automaticky generovaný prehľad všetkých hlavných rečníkov, prednášajúcich, "
"rozdelenia sál a medailónov."

#: blocks/ticket-pass-verifier/block.json
msgctxt "block title"
msgid "Cyber Events Digitaler Ticket-Pass"
msgstr "Cyber Events — Digitálny preukaz účastníka"

#: blocks/ticket-pass-verifier/block.json
msgctxt "block description"
msgid ""
"Teilnehmerpass für bestätigte Anmeldungen mit Ticketnummer, Veranstaltung, "
"Ort und Druckfunktion."
msgstr ""
"Preukaz účastníka pre potvrdené registrácie s číslom vstupenky, podujatím, "
"miestom konania a funkciou tlače."

