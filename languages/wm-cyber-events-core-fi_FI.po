#: blocks/agenda-matrix/block.json
msgctxt "block title"
msgid "Cyber Events Konferenz-Agenda"
msgstr "Cyber Events Konferenssiohjelma"

#: blocks/agenda-matrix/block.json
msgctxt "block description"
msgid ""
"Interaktiver Multi-Track Konferenzplan mit Zeitstrahl, Referenten-Details, "
"Raumfiltern und iCal (.ics) Download."
msgstr ""
"Vuorovaikutteinen monilinjainen konferenssiohjelma aikajanalla, "
"puhujatiedoilla, salisuodattimilla ja iCal (.ics) -latauksella."

#: blocks/calendar-views/block.json
msgctxt "block title"
msgid "Cyber Events Multi-View Pro (Kalender, Agenda & Tracks)"
msgstr "Cyber Events Multi-View Pro (kalenteri, ohjelma ja linjat)"

#: blocks/calendar-views/block.json
msgctxt "block description"
msgid ""
"Erweiterte Kalender- & Agenda-Suite mit 7 interaktiven Frontend-Ansichten: "
"Monatskalender, Wochenplan, Tagesagenda, Listenansicht, Fotokarten, "
"Raumkarte und Summit Multi-Track Matrix."
msgstr ""
"Laaja kalenteri- ja ohjelmakokonaisuus 7 vuorovaikutteisella näkymällä: "
"kuukausikalenteri, viikko-ohjelma, päiväohjelma, luettelonäkymä, kuvakortit, "
"tilakartta ja monilinjainen konferenssimatriisi."

#: blocks/calendar-views/block.json
msgctxt "block keyword"
msgid "event"
msgstr "tapahtuma"

#: blocks/calendar-views/block.json
