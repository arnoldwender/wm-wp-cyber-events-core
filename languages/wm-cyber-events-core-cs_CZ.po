msgstr "matice"

#: blocks/calendar-widget/block.json
msgctxt "block title"
msgid "Cyber Events Kalender & .ics Widget"
msgstr "Cyber Events — Widget kalendáře a .ics"

#: blocks/calendar-widget/block.json
msgctxt "block description"
msgid ""
"Kalender-Widget mit .ics-Download und Links zu Google Kalender, Outlook Web "
"und Microsoft 365."
msgstr ""
"Kalendářový widget se stažením souboru .ics a odkazy do Kalendáře Google, "
"Outlook Web a Microsoft 365."

#: blocks/event-hero/block.json
msgctxt "block title"
msgid "Cyber Event Hero & Countdown Banner"
msgstr "Cyber Event — Úvodní banner a odpočítávání"

#: blocks/event-hero/block.json
msgctxt "block description"
msgid ""
"Veranstaltungs-Kopfbereich mit Countdown, Eckdaten, Status und Anmelde-"
"Buttons."
msgstr ""
"Úvodní sekce události s odpočítáváním, klíčovými údaji, stavem a "
"registračními tlačítky."

#: blocks/events-grid/block.json
msgctxt "block title"
msgid "Cyber Events Übersicht & Archiv Grid"
msgstr "Cyber Events — Mřížka přehledu a archivu"

#: blocks/events-grid/block.json
msgctxt "block description"
msgid ""
"Dynamische Kartenübersicht aller anstehenden Konferenzen, Symposien und "
"Workshops mit Suchleiste und Status-Filtern."
msgstr ""
"Dynamický kartový přehled nadcházejících konferencí, sympozií a workshopů s "
"vyhledávacím panelem a filtry stavu."

#: blocks/registration-form/block.json
msgctxt "block title"
msgid "Cyber Events Registrierungsformular"
msgstr "Cyber Events — Registrační formulář"

#: blocks/registration-form/block.json
msgctxt "block description"
msgid ""
"Anmeldeformular mit Double Opt-in über Brevo, optionalem Profilbild und "
"Einwilligung zu Fotoaufnahmen."
msgstr ""
"Registrační formulář s dvojitým potvrzením přes Brevo, volitelnou profilovou "
"fotografií a souhlasem s fotografováním."

#: blocks/seat-map/block.json
msgctxt "block title"
msgid "Cyber Events Sitzplan"
msgstr "Cyber Events — Plán míst"

#: blocks/seat-map/block.json
msgctxt "block description"
msgid ""
"Belegung aller Sessions einer Veranstaltung als SVG, laufend aktualisiert "
"über Server-Sent Events."
msgstr ""
"Obsazenost všech relací události jako grafika SVG, průběžně aktualizovaná "
"pomocí Server-Sent Events."

#: blocks/security-trust-badge/block.json
msgctxt "block title"
msgid "Cyber Events Security & Trust Badges"
msgstr "Cyber Events — Odznaky bezpečnosti a důvěry"

#: blocks/security-trust-badge/block.json
msgctxt "block description"
msgid ""
"Übersicht der Datenschutz- und Sicherheitsfunktionen des Plugins: Double Opt-"
"in, Löschfristen, Audit-Log, Rechnungs-XML."
msgstr ""
"Přehled funkcí ochrany osobních údajů a zabezpečení pluginu: Double Opt-in, "
"lhůty uchovávání, auditní protokol, fakturační XML."

#: blocks/session-selector/block.json
msgctxt "block title"
msgid "Cyber Events Session- & Workshop-Selektor"
msgstr "Cyber Events — Výběr relací a workshopů"

#: blocks/session-selector/block.json
msgctxt "block description"
msgid ""
"Session-Auswahl für bestätigte Anmeldungen: Plätze werden beim Speichern "
"vergeben, solange die Session nicht ausgebucht ist."
msgstr ""
"Výběr relací pro potvrzené registrace: místa jsou přidělována při uložení, "
"dokud není kapacita vyčerpána."

#: blocks/speaker-grid/block.json
msgctxt "block title"
msgid "Cyber Events Referenten & Speaker Grid"
msgstr "Cyber Events — Mřížka řečníků a expertů"

#: blocks/speaker-grid/block.json
msgctxt "block description"
msgid ""
"Automatisch generierte Übersicht aller Keynote-Speaker, Referenten, "
"Raumverteilung und Bio-Details."
msgstr ""
"Automaticky generovaný přehled všech hlavních řečníků, přednášejících, "
"rozdělení sálů a medailonků."

#: blocks/ticket-pass-verifier/block.json
msgctxt "block title"
msgid "Cyber Events Digitaler Ticket-Pass"
msgstr "Cyber Events — Digitální průkaz účastníka"

#: blocks/ticket-pass-verifier/block.json
msgctxt "block description"
msgid ""
"Teilnehmerpass für bestätigte Anmeldungen mit Ticketnummer, Veranstaltung, "
"Ort und Druckfunktion."
msgstr ""
"Průkaz účastníka pro potvrzené registrace s číslem vstupenky, událostí, "
"místem konání a funkcí tisku."

