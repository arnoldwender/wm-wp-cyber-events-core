#: blocks/agenda-matrix/block.json
msgctxt "block title"
msgid "Cyber Events Konferenz-Agenda"
msgstr "Cyber Events — Program konferencije"

#: blocks/agenda-matrix/block.json
msgctxt "block description"
msgid ""
"Interaktiver Multi-Track Konferenzplan mit Zeitstrahl, Referenten-Details, "
"Raumfiltern und iCal (.ics) Download."
msgstr ""
"Interaktivni višesmjerni raspored konferencije s vremenskom crtom, detaljima "
"predavača, filtrima dvorana i preuzimanjem iCal (.ics) datoteke."

#: blocks/calendar-views/block.json
msgctxt "block title"
msgid "Cyber Events Multi-View Pro (Kalender, Agenda & Tracks)"
msgstr "Cyber Events Multi-View Pro (kalendar, program i smjerovi)"

#: blocks/calendar-views/block.json
msgctxt "block description"
msgid ""
"Erweiterte Kalender- & Agenda-Suite mit 7 interaktiven Frontend-Ansichten: "
"Monatskalender, Wochenplan, Tagesagenda, Listenansicht, Fotokarten, "
"Raumkarte und Summit Multi-Track Matrix."
msgstr ""
"Prošireni paket kalendara i programa sa 7 interaktivnih prikaza: mjesečni "
"kalendar, tjedni raspored, dnevni program, prikaz popisa, foto-kartice, "
"karta dvorana i višesmjerna matrica summita."

