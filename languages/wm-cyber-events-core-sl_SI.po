msgstr "matrika"

#: blocks/calendar-widget/block.json
msgctxt "block title"
msgid "Cyber Events Kalender & .ics Widget"
msgstr "Cyber Events — Gradnik koledarja in .ics"

#: blocks/calendar-widget/block.json
msgctxt "block description"
msgid ""
"Kalender-Widget mit .ics-Download und Links zu Google Kalender, Outlook Web "
"und Microsoft 365."
msgstr ""
"Koledarski gradnik s prenosom .ics in povezavami do storitev Google Koledar, "
"Outlook Web in Microsoft 365."

#: blocks/event-hero/block.json
msgctxt "block title"
msgid "Cyber Event Hero & Countdown Banner"
msgstr "Cyber Event — Glavni pas in odštevalnik"

#: blocks/event-hero/block.json
msgctxt "block description"
msgid ""
"Veranstaltungs-Kopfbereich mit Countdown, Eckdaten, Status und Anmelde-"
"Buttons."
msgstr ""
"Glavni odsek dogodka z odštevalnikom, ključnimi podatki, značko stanja in "
"gumbi za prijavo."

#: blocks/events-grid/block.json
msgctxt "block title"
msgid "Cyber Events Übersicht & Archiv Grid"
msgstr "Cyber Events — Mreža pregleda in arhiva"

#: blocks/events-grid/block.json
msgctxt "block description"
msgid ""
"Dynamische Kartenübersicht aller anstehenden Konferenzen, Symposien und "
"Workshops mit Suchleiste und Status-Filtern."
msgstr ""
"Dinamičen kartični pregled prihajajočih konferenc, simpozijev in delavnic z "
"iskalno vrstico ter filtri stanja."

#: blocks/registration-form/block.json
msgctxt "block title"
msgid "Cyber Events Registrierungsformular"
msgstr "Cyber Events — Prijavni obrazec"

#: blocks/registration-form/block.json
msgctxt "block description"
msgid ""
"Anmeldeformular mit Double Opt-in über Brevo, optionalem Profilbild und "
"Einwilligung zu Fotoaufnahmen."
msgstr ""
"Prijavni obrazec z dvojno potrditvijo prek storitve Brevo, izbirno profilno "
"fotografijo in privolitvijo za fotografiranje."

#: blocks/seat-map/block.json
msgctxt "block title"
msgid "Cyber Events Sitzplan"
msgstr "Cyber Events — Načrt sedežev"

#: blocks/seat-map/block.json
msgctxt "block description"
msgid ""
"Belegung aller Sessions einer Veranstaltung als SVG, laufend aktualisiert "
"über Server-Sent Events."
msgstr ""
"Zasedenost vseh sekcij dogodka kot grafika SVG, sproti posodobljena prek "
"Server-Sent Events."

#: blocks/security-trust-badge/block.json
msgctxt "block title"
msgid "Cyber Events Security & Trust Badges"
msgstr "Cyber Events — Značke varnosti in zaupanja"

#: blocks/security-trust-badge/block.json
msgctxt "block description"
msgid ""
"Übersicht der Datenschutz- und Sicherheitsfunktionen des Plugins: Double Opt-"
"in, Löschfristen, Audit-Log, Rechnungs-XML."
msgstr ""
"Pregled funkcij zasebnosti in varnosti vtičnika: dvojna potrditev, roki "
"hrambe, revizijski dnevnik, XML-računi."

#: blocks/session-selector/block.json
msgctxt "block title"
msgid "Cyber Events Session- & Workshop-Selektor"
msgstr "Cyber Events — Izbirnik sekcij in delavnic"

#: blocks/session-selector/block.json
msgctxt "block description"
msgid ""
"Session-Auswahl für bestätigte Anmeldungen: Plätze werden beim Speichern "
"vergeben, solange die Session nicht ausgebucht ist."
msgstr ""
"Izbirnik sekcij za potrjene prijave: mesta se dodelijo ob shranjevanju, "
"dokler so na voljo proste kapacitete."

#: blocks/speaker-grid/block.json
msgctxt "block title"
msgid "Cyber Events Referenten & Speaker Grid"
msgstr "Cyber Events — Mreža govorcev in strokovnjakov"

#: blocks/speaker-grid/block.json
msgctxt "block description"
msgid ""
"Automatisch generierte Übersicht aller Keynote-Speaker, Referenten, "
"Raumverteilung und Bio-Details."
msgstr ""
"Samodejno ustvarjen pregled vseh osrednjih govorcev, predavateljev, "
"razporeditve dvoran in življenjepisov."

#: blocks/ticket-pass-verifier/block.json
msgctxt "block title"
msgid "Cyber Events Digitaler Ticket-Pass"
msgstr "Cyber Events — Digitalna izkaznica"

#: blocks/ticket-pass-verifier/block.json
msgctxt "block description"
msgid ""
"Teilnehmerpass für bestätigte Anmeldungen mit Ticketnummer, Veranstaltung, "
"Ort und Druckfunktion."
msgstr ""
"Izkaznica udeleženca za potrjene prijave s številko vstopnice, dogodkom, "
"prizoriščem in gumbom za tisk."

