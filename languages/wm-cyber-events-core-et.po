#: blocks/calendar-widget/block.json
msgctxt "block title"
msgid "Cyber Events Kalender & .ics Widget"
msgstr "Cyber Events Kalendri- ja .ics-vidin"

#: blocks/calendar-widget/block.json
msgctxt "block description"
msgid ""
"Kalender-Widget mit .ics-Download und Links zu Google Kalender, Outlook Web "
"und Microsoft 365."
msgstr ""
"Kalendrividin .ics-allalaadimise ning Google'i kalendri, Outlook Webi ja "
"Microsoft 365 linkidega."

#: blocks/event-hero/block.json
msgctxt "block title"
msgid "Cyber Event Hero & Countdown Banner"
msgstr "Cyber Event Päise- ja pöördloendusbänner"

#: blocks/event-hero/block.json
msgctxt "block description"
msgid ""
"Veranstaltungs-Kopfbereich mit Countdown, Eckdaten, Status und Anmelde-"
"Buttons."
msgstr ""
"Sündmuse päisebänner pöördloenduse, põhiandmete, olekumärgise ja "
"registreerimisnuppudega."

#: blocks/events-grid/block.json
msgctxt "block title"
msgid "Cyber Events Übersicht & Archiv Grid"
msgstr "Cyber Events Ülevaate- ja arhiiviruudustik"

#: blocks/events-grid/block.json
msgctxt "block description"
msgid ""
"Dynamische Kartenübersicht aller anstehenden Konferenzen, Symposien und "
"Workshops mit Suchleiste und Status-Filtern."
msgstr ""
"Dünaamiline kaardiülevaade eelseisvatest konverentsidest, sümpoosionidest ja "
"töötubadest otsinguriba ning olekufiltritega."

#: blocks/registration-form/block.json
msgctxt "block title"
msgid "Cyber Events Registrierungsformular"
msgstr "Cyber Events Registreerimisvorm"

#: blocks/registration-form/block.json
msgctxt "block description"
msgid ""
"Anmeldeformular mit Double Opt-in über Brevo, optionalem Profilbild und "
"Einwilligung zu Fotoaufnahmen."
msgstr ""
"Registreerimisvorm Brevo topeltkinnituse, valikulise profiilifoto ja "
"pildistamisnõusolekuga."

#: blocks/seat-map/block.json
msgctxt "block title"
msgid "Cyber Events Sitzplan"
msgstr "Cyber Events Saaliplaan"

#: blocks/seat-map/block.json
msgctxt "block description"
msgid ""
"Belegung aller Sessions einer Veranstaltung als SVG, laufend aktualisiert "
"über Server-Sent Events."
msgstr ""
"Sündmuse kõigi sessioonide täituvus SVG-na, hoitakse ajakohasena Server-Sent "
"Eventsi kaudu."

#: blocks/security-trust-badge/block.json
msgctxt "block title"
msgid "Cyber Events Security & Trust Badges"
msgstr "Cyber Events Turva- ja usaldusmärgised"

#: blocks/security-trust-badge/block.json
msgctxt "block description"
msgid ""
"Übersicht der Datenschutz- und Sicherheitsfunktionen des Plugins: Double Opt-"
"in, Löschfristen, Audit-Log, Rechnungs-XML."
msgstr ""
"Ülevaade plugina privaatsus- ja turvafunktsioonidest: topeltkinnitus, "
"säilitustähtajad, auditilogi ja arve XML."

#: blocks/session-selector/block.json
msgctxt "block title"
msgid "Cyber Events Session- & Workshop-Selektor"
msgstr "Cyber Events Sessiooni- ja töötoavalija"

#: blocks/session-selector/block.json
msgctxt "block description"
msgid ""
"Session-Auswahl für bestätigte Anmeldungen: Plätze werden beim Speichern "
"vergeben, solange die Session nicht ausgebucht ist."
msgstr ""
"Sessioonivalija kinnitatud registreeringutele: kohad eraldatakse "
"salvestamisel seni, kuni vabu kohti jätkub."

#: blocks/speaker-grid/block.json
msgctxt "block title"
msgid "Cyber Events Referenten & Speaker Grid"
msgstr "Cyber Events Esinejate ja ekspertide ruudustik"

#: blocks/speaker-grid/block.json
msgctxt "block description"
msgid ""
"Automatisch generierte Übersicht aller Keynote-Speaker, Referenten, "
"Raumverteilung und Bio-Details."
msgstr ""
"Automaatselt koostatud ülevaade peaesinejatest, sessiooniettekannetest, "
"ruumijaotusest ja esinejate tutvustustest."

#: blocks/ticket-pass-verifier/block.json
msgctxt "block title"
msgid "Cyber Events Digitaler Ticket-Pass"
msgstr "Cyber Events Digitaalne piletikaart"

#: blocks/ticket-pass-verifier/block.json
msgctxt "block description"
msgid ""
"Teilnehmerpass für bestätigte Anmeldungen mit Ticketnummer, Veranstaltung, "
"Ort und Druckfunktion."
msgstr ""
"Osalejakaart kinnitatud registreeringutele koos piletinumbri, sündmuse, "
"toimumiskoha ja printimisnupuga."

