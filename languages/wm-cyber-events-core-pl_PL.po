#: blocks/calendar-widget/block.json
msgctxt "block title"
msgid "Cyber Events Kalender & .ics Widget"
msgstr "Cyber Events — Widżet kalendarza i .ics"

#: blocks/calendar-widget/block.json
msgctxt "block description"
msgid ""
"Kalender-Widget mit .ics-Download und Links zu Google Kalender, Outlook Web "
"und Microsoft 365."
msgstr ""
"Widżet kalendarza z pobieraniem pliku .ics oraz linkami do Kalendarza "
"Google, Outlook Web i Microsoft 365."

#: blocks/event-hero/block.json
msgctxt "block title"
msgid "Cyber Event Hero & Countdown Banner"
msgstr "Cyber Event — Baner Hero i licznik odliczania"

#: blocks/event-hero/block.json
msgctxt "block description"
msgid ""
"Veranstaltungs-Kopfbereich mit Countdown, Eckdaten, Status und Anmelde-"
"Buttons."
msgstr ""
"Sekcja nagłówkowa wydarzenia z odliczaniem, kluczowymi danymi, statusem i "
"przyciskami rejestracji."

#: blocks/events-grid/block.json
msgctxt "block title"
msgid "Cyber Events Übersicht & Archiv Grid"
msgstr "Cyber Events — Siatka przeglądu i archiwum"

#: blocks/events-grid/block.json
msgctxt "block description"
msgid ""
"Dynamische Kartenübersicht aller anstehenden Konferenzen, Symposien und "
"Workshops mit Suchleiste und Status-Filtern."
msgstr ""
"Dynamiczny przegląd kart nadchodzących konferencji, sympozjów i warsztatów z "
"paskiem wyszukiwania i filtrami statusu."

#: blocks/registration-form/block.json
msgctxt "block title"
msgid "Cyber Events Registrierungsformular"
msgstr "Cyber Events — Formularz rejestracji"

#: blocks/registration-form/block.json
msgctxt "block description"
msgid ""
"Anmeldeformular mit Double Opt-in über Brevo, optionalem Profilbild und "
"Einwilligung zu Fotoaufnahmen."
msgstr ""
"Formularz rejestracji z podwójnym potwierdzeniem (Double Opt-in) przez "
"Brevo, opcjonalnym zdjęciem profilowym oraz zgodą na wykonywanie zdjęć."

#: blocks/seat-map/block.json
msgctxt "block title"
msgid "Cyber Events Sitzplan"
msgstr "Cyber Events — Plan miejsc"

#: blocks/seat-map/block.json
msgctxt "block description"
msgid ""
"Belegung aller Sessions einer Veranstaltung als SVG, laufend aktualisiert "
"über Server-Sent Events."
msgstr ""
"Obłożenie wszystkich sesji wydarzenia jako grafika SVG, aktualizowane na "
"bieżąco za pomocą Server-Sent Events."

#: blocks/security-trust-badge/block.json
msgctxt "block title"
msgid "Cyber Events Security & Trust Badges"
msgstr "Cyber Events — Odznaki bezpieczeństwa i zaufania"

#: blocks/security-trust-badge/block.json
msgctxt "block description"
msgid ""
"Übersicht der Datenschutz- und Sicherheitsfunktionen des Plugins: Double Opt-"
"in, Löschfristen, Audit-Log, Rechnungs-XML."
msgstr ""
"Przegląd funkcji ochrony danych i bezpieczeństwa wtyczki: Double Opt-in, "
"okresy przechowywania, dziennik audytu, faktury XML."

#: blocks/session-selector/block.json
msgctxt "block title"
msgid "Cyber Events Session- & Workshop-Selektor"
msgstr "Cyber Events — Selektor sesji i warsztatów"

#: blocks/session-selector/block.json
msgctxt "block description"
msgid ""
"Session-Auswahl für bestätigte Anmeldungen: Plätze werden beim Speichern "
"vergeben, solange die Session nicht ausgebucht ist."
msgstr ""
"Wybór sesji dla potwierdzonych rejestracji: miejsca są przydzielane przy "
"zapisie, dopóki w sesji są wolne miejsca."

#: blocks/speaker-grid/block.json
msgctxt "block title"
msgid "Cyber Events Referenten & Speaker Grid"
msgstr "Cyber Events — Siatka prelegentów i ekspertów"

#: blocks/speaker-grid/block.json
msgctxt "block description"
msgid ""
"Automatisch generierte Übersicht aller Keynote-Speaker, Referenten, "
"Raumverteilung und Bio-Details."
msgstr ""
"Automatycznie generowany przegląd wszystkich głównych mówców, prelegentów, "
"podziału sal i biogramów."

#: blocks/ticket-pass-verifier/block.json
msgctxt "block title"
msgid "Cyber Events Digitaler Ticket-Pass"
msgstr "Cyber Events — Cyfrowy identyfikator biletowy"

#: blocks/ticket-pass-verifier/block.json
msgctxt "block description"
msgid ""
"Teilnehmerpass für bestätigte Anmeldungen mit Ticketnummer, Veranstaltung, "
"Ort und Druckfunktion."
msgstr ""
"Identyfikator uczestnika dla potwierdzonych rejestracji z numerem biletu, "
"wydarzeniem, miejscem i funkcją drukowania."

