#: blocks/agenda-matrix/block.json
msgctxt "block title"
msgid "Cyber Events Konferenz-Agenda"
msgstr "Cyber Events — Program konferencji"

#: blocks/agenda-matrix/block.json
msgctxt "block description"
msgid ""
"Interaktiver Multi-Track Konferenzplan mit Zeitstrahl, Referenten-Details, "
"Raumfiltern und iCal (.ics) Download."
msgstr ""
"Interaktywny wielościeżkowy plan konferencji z osią czasu, szczegółami "
"prelegentów, filtrami sal i pobieraniem pliku iCal (.ics)."

#: blocks/calendar-views/block.json
msgctxt "block title"
msgid "Cyber Events Multi-View Pro (Kalender, Agenda & Tracks)"
msgstr "Cyber Events Multi-View Pro (kalendarz, program i ścieżki)"

#: blocks/calendar-views/block.json
msgctxt "block description"
msgid ""
"Erweiterte Kalender- & Agenda-Suite mit 7 interaktiven Frontend-Ansichten: "
"Monatskalender, Wochenplan, Tagesagenda, Listenansicht, Fotokarten, "
"Raumkarte und Summit Multi-Track Matrix."
msgstr ""
"Rozszerzony pakiet kalendarza i programu z 7 interaktywnymi widokami: "
"kalendarz miesięczny, harmonogram tygodniowy, program dzienny, widok listy, "
"karty ze zdjęciami, mapa sal oraz wielościeżkowa matryca szczytu."

